# AIRS Runtime Security Framework — Environment Variables

# LLM Provider (anthropic | openai)
LLM_PROVIDER=anthropic

# Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (optional — only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Model overrides (optional)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# LLM request timeout (seconds)
LLM_TIMEOUT=30

# Service URLs (used when running services outside Docker)
GATEWAY_URL=http://localhost:8000
APP_A_URL=http://localhost:8001
APP_B_URL=http://localhost:8002
APP_C_URL=http://localhost:8003
