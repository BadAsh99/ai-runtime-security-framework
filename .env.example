# AI Runtime Security Framework - Environment Configuration

# ============================================================================
# Gateway Configuration
# ============================================================================

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO
AUDIT_LOG_FILE=audit.log

# ============================================================================
# Service Configuration
# ============================================================================

# Content Moderation Service
CONTENT_MOD_HOST=0.0.0.0
CONTENT_MOD_PORT=8001

# Finance Analysis Service
FINANCE_HOST=0.0.0.0
FINANCE_PORT=8002

# Support Chatbot Service
SUPPORT_HOST=0.0.0.0
SUPPORT_PORT=8003

# ============================================================================
# LLM Configuration (Phase 1: Mock, Phase 2: Real)
# ============================================================================

# Mock LLM settings
LLM_API_BASE=http://localhost:8000
LLM_MODEL=mock-gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=200

# For Phase 2: Real LLM providers
# Uncomment and fill in for production use
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Security Configuration
# ============================================================================

# Injection Detection Sensitivity
# 'relaxed': Only flag high-confidence threats
# 'moderate': Flag medium-high confidence threats (default)
# 'strict': Flag all potential threats
INJECTION_SENSITIVITY=moderate

# Rate Limiting (Phase 2)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# Dashboard Configuration
# ============================================================================

STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================================================
# Database Configuration (Phase 2)
# ============================================================================

# Uncomment when adding database support
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_runtime
# DB_LOG_AUDIT_TRAIL=true

# ============================================================================
# Monitoring & Observability (Phase 2)
# ============================================================================

# Prometheus metrics
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# ============================================================================
# Development Settings
# ============================================================================

DEBUG=false
ENVIRONMENT=production

# For local development, set to true
# ENVIRONMENT=development
# DEBUG=true
